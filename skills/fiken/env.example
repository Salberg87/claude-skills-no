# Fiken skill — copy to a real file and point FIKEN_ENV at it, or export these directly.
#   cp env.example ~/.config/fiken/.env  &&  export FIKEN_ENV=~/.config/fiken/.env
# Get a personal API token: Fiken → Innstillinger → API
FIKEN_API_TOKEN=your-fiken-personal-api-token
FIKEN_COMPANY_SLUG=your-company-as
